# This is a learning configuration. Copy it to .env only on the GPU server.
VLLM_IMAGE=vllm/vllm-openai:latest
MODEL_ID=Qwen/Qwen3-0.6B
SERVED_MODEL_NAME=titan-preview
MAX_MODEL_LEN=4096
GPU_MEMORY_UTILIZATION=0.80

# This token protects only the localhost lab endpoint. Replace it before running.
API_KEY=replace-this-with-a-long-random-lab-token

# Leave blank for a public model. Never commit a real token.
HF_TOKEN=

