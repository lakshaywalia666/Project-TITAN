# Replace this before starting the control-plane API. Never commit .env.
TITAN_ADMIN_TOKEN=replace-with-at-least-24-random-characters

TITAN_DATABASE=/var/lib/titan/titan-control.db
TITAN_CONTROL_HOST=0.0.0.0
TITAN_CONTROL_PORT=8090
TITAN_RECONCILE_INTERVAL_SECONDS=2
TITAN_RECONCILE_BATCH_SIZE=20
TITAN_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Credential-free Cloud Launchpad planner. It creates assessments and dry-run
# plans only; live cloud deployment is deliberately a later approval gate.
TITAN_LAUNCHPAD_HOST=0.0.0.0
TITAN_LAUNCHPAD_PORT=8300
TITAN_LAUNCHPAD_DATABASE=/var/lib/titan/titan-launchpad.db

# Optional short-lived signed identity tokens for automation/workload labs.
# TITAN_JWT_SECRET=replace-with-at-least-32-random-bytes
TITAN_JWT_ISSUER=titan-local
TITAN_JWT_AUDIENCE=titan

# The zero-cost default uses Titan's deterministic offline backend. Set both
# values only while a local or rented vLLM server is running.
TITAN_AI_HOST=0.0.0.0
TITAN_AI_PORT=8100
TITAN_KNOWLEDGE_DATABASE=/var/lib/titan/titan-knowledge.db
TITAN_AI_ALLOWED_MODELS_JSON={"local":["titan-offline"]}
TITAN_AI_TOKEN_BUDGETS_JSON={"local":100000}
TITAN_AI_REQUEST_LIMITS_JSON={"local":60}
TITAN_AI_DEFAULT_REQUESTS_PER_MINUTE=60
# TITAN_VLLM_URL=http://gpu-host:8000
# TITAN_VLLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct
# TITAN_VLLM_API_KEY=replace-when-required

# Set only the credentials required by the optional compose.data.yaml profile
# you are starting. Keep the real values in the ignored .env file.
# TITAN_POSTGRES_PASSWORD=replace-with-a-long-random-value
# TITAN_REDIS_PASSWORD=replace-with-a-long-random-value
# TITAN_MINIO_USER=titan-local-admin
# TITAN_MINIO_PASSWORD=replace-with-a-long-random-value
